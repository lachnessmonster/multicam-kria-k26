/dts-v1/;
/plugin/;

/*
 * kv260-cam.dtso  -- native V4L2 pipeline
 *
 * Compatible string is -5.0. This is the only value the xilinx-csi2rxss
 * driver in kernel 5.15.0-1027-xilinx-zynqmp matches; -2.0/-3.0/-4.0 come
 * from a third-party fork and silently fail to match. The v3.0 IP register
 * map is compatible (CCR at 0x00, ISR at 0x24), so this is safe.
 *
 * REQUIRES the rebuilt bitstream containing xlconcat_0. The original
 * design_1.tcl never wired mipi_csi2_rx_subsyst_0/csirxss_csi_irq to the
 * PS, which made xilinx-csi2rxss fail probe with "IRQ index 0 not found"
 * (-ENXIO, logged only at pr_debug level -- hence the silent failure).
 *
 * camcap is commented out: it and vcap_csi both claim <&v_frmbuf_wr_0 0>
 * and cannot coexist. Swap which one is active depending on whether you
 * are using camcap.ko or /dev/video0.
 */

&fpga_full {
    firmware-name = "kv260-cam.bit.bin";
    resets = <&zynqmp_reset 0x74>;
};

&amba {
    #address-cells = <2>;
    #size-cells = <2>;

    clocking0: clocking0 {
        #clock-cells = <0>;
        compatible = "xlnx,fclk";
        clocks = <&zynqmp_clk 71>;
        assigned-clocks = <&zynqmp_clk 71>;
        assigned-clock-rates = <99999999>;
        clock-output-names = "fabric_clk";
    };

    clocking1: clocking1 {
        #clock-cells = <0>;
        compatible = "xlnx,fclk";
        clocks = <&zynqmp_clk 72>;
        assigned-clocks = <&zynqmp_clk 72>;
        assigned-clock-rates = <199999998>;
        clock-output-names = "fabric_clk";
    };

    imx219_clk: imx219_clk {
        #clock-cells = <0>;
        compatible = "fixed-clock";
        clock-frequency = <24000000>;
    };

    imx219_vana: imx219_vana {
        compatible = "regulator-fixed";
        regulator-name = "imx219_vana";
        regulator-min-microvolt = <2800000>;
        regulator-max-microvolt = <2800000>;
    };

    imx219_vdig: imx219_vdig {
        compatible = "regulator-fixed";
        regulator-name = "imx219_vdig";
        regulator-min-microvolt = <1800000>;
        regulator-max-microvolt = <1800000>;
    };

    imx219_vddl: imx219_vddl {
        compatible = "regulator-fixed";
        regulator-name = "imx219_vddl";
        regulator-min-microvolt = <1200000>;
        regulator-max-microvolt = <1200000>;
    };

    axi_iic_0: i2c@a0010000 {
        compatible = "xlnx,axi-iic-2.1", "xlnx,xps-iic-2.00.a";
        reg = <0x0 0xa0010000 0x0 0x10000>;
        clocks = <&zynqmp_clk 71>;
        clock-names = "s_axi_aclk";
        interrupt-parent = <&gic>;
        interrupts = <0 89 4>;
        #address-cells = <1>;
        #size-cells = <0>;

        i2c-mux@74 {
            compatible = "nxp,pca9546";
            reg = <0x74>;
            #address-cells = <1>;
            #size-cells = <0>;

            i2c@0 { reg = <0>; #address-cells = <1>; #size-cells = <0>; };
            i2c@1 { reg = <1>; #address-cells = <1>; #size-cells = <0>; };

            i2c@2 {
                reg = <2>;
                #address-cells = <1>;
                #size-cells = <0>;

                imx219: sensor@10 {
                    compatible = "sony,imx219";
                    reg = <0x10>;
                    clocks = <&imx219_clk>;
                    clock-names = "xclk";
                    VANA-supply = <&imx219_vana>;
                    VDIG-supply = <&imx219_vdig>;
                    VDDL-supply = <&imx219_vddl>;

                    port {
                        imx219_0: endpoint {
                            remote-endpoint = <&csi_in>;
                            data-lanes = <1 2>;
                            clock-noncontinuous;
                            link-frequencies = /bits/ 64 <456000000>;
                        };
                    };
                };
            };

            i2c@3 { reg = <3>; #address-cells = <1>; #size-cells = <0>; };
        };
    };

    mipi_csi2_rx_subsyst_0: mipi_csi2_rx_subsystem@a0020000 {
        compatible = "xlnx,mipi-csi2-rx-subsystem-5.0";
        reg = <0x0 0xa0020000 0x0 0x2000>;

        /*
         * xlconcat_0 feeds pl_ps_irq0: In0 = axi_iic_0 (SPI 89),
         * In1 = mipi_csi2_rx_subsyst_0/csirxss_csi_irq (SPI 90).
         * If the CSI interrupt never fires, check In0/In1 are not swapped
         * in the block design -- try 89 instead of 90.
         * Verify with: grep -i csi /proc/interrupts
         */
        interrupt-parent = <&gic>;
        interrupts = <0 90 4>;

        /* 0x2b = RAW10, matches CONFIG.CMN_PXL_FORMAT in design_1.tcl */
        xlnx,csi-pxl-format = <0x2b>;

        /* Video Format Bridge enabled: CSI drives an AXI4-Stream video_out */
        xlnx,vfb;

        /* Both are pl_clk0 in design_1.tcl */
        clock-names = "lite_aclk", "video_aclk";
        clocks = <&zynqmp_clk 71>, <&zynqmp_clk 71>;

        ports {
            #address-cells = <1>;
            #size-cells = <0>;

            port@0 {
                /* Sink: from the sensor */
                reg = <0>;
                csi_in: endpoint {
                    remote-endpoint = <&imx219_0>;
                    data-lanes = <1 2>;
                };
            };

            port@1 {
                /* Source: to the capture node */
                reg = <1>;
                csi_out: endpoint {
                    remote-endpoint = <&vcap_csi_in>;
                };
            };
        };
    };

    v_frmbuf_wr_0: v_frmbuf_wr@a0000000 {
        compatible = "xlnx,v-frmbuf-wr-3.1", "xlnx,v-frmbuf-wr-v3.0", "xlnx,axi-frmbuf-wr-v2.2";
        reg = <0x0 0xa0000000 0x0 0x10000>;
        #dma-cells = <1>;
        interrupt-parent = <&gic>;
        interrupt-names = "interrupt";
        interrupts = <0 104 4>;
        clocks = <&zynqmp_clk 71>;
        clock-names = "ap_clk";
        reset-gpios = <&gpio 79 1>;
        xlnx,dma-addr-width = <32>;
        xlnx,dma-align = <8>;
        xlnx,pixels-per-clock = <1>;
        xlnx,vid-formats = "rggb10";
        xlnx,max-width = <1920>;
        xlnx,max-height = <1080>;
        xlnx,max-nr-planes = <1>;
    };

    /*
     * Xilinx Video IP Pipeline. This node builds the media graph and
     * creates /dev/media0 and /dev/video0. Without it, csi2rxss registers
     * only as an unbound async subdev and no device nodes appear.
     */
    vcap_csi: vcap_csi {
        compatible = "xlnx,video";
        dmas = <&v_frmbuf_wr_0 0>;
        dma-names = "port0";

        ports {
            #address-cells = <1>;
            #size-cells = <0>;

            port@0 {
                reg = <0>;
                direction = "input";
                vcap_csi_in: endpoint {
                    remote-endpoint = <&csi_out>;
                };
            };
        };
    };

    /*
     * Legacy camcap path. Mutually exclusive with vcap_csi above -- both
     * claim <&v_frmbuf_wr_0 0>. Uncomment this and comment out vcap_csi
     * (and port@1 / csi_out in the CSI node) to fall back to camcap.ko.
     *
     * camcap: camcap {
     *     compatible = "kv260,camcap";
     *     dmas = <&v_frmbuf_wr_0 0>;
     *     dma-names = "rx";
     * };
     */
};
